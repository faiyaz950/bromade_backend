DB_NAME=brolytics
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
OTP_PROVIDER=mock
FIREBASE_PROJECT_ID=homeservice-37e32
PAYMENT_GATEWAY=mock_razorpay
